# Pantalla principal (RootWidget): cabecera, filtros, listas y pie.
#
# Solo el ASPECTO; la lógica está en src/ui/widgets/root.py.

#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import theme ui.theme
#:import icons ui.icons
#:import tr i18n.tr
#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# Cabecera (logo, título, búsqueda y actualizar), barra de filtros, cuerpo con
# barra lateral + vistas (tienda/instaladas/ajustes) y pie con estado y zoom.
<RootWidget>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: theme.BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(72)
        padding: [dp(16), dp(10), dp(16), dp(8)]
        spacing: dp(14)
        canvas.before:
            Color:
                rgba: theme.CHROME
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderLogo:
            size_hint: None, None
            size: self.minimum_size
            pos_hint: {"center_y": .5}
            spacing: dp(10)
            padding: [0, 0]
            Image:
                source: "images/app_icon.png"
                size_hint: (None, None)
                size: dp(52), dp(52)
                allow_stretch: True
                keep_ratio: True
            Label:
                text: tr("Blender Downloads Manager")
                font_size: sp(19)
                bold: True
                color: theme.TEXT
                size_hint_x: None
                width: self.texture_size[0]
                size_hint_y: None
                height: dp(52)
        Widget:
        # Búsqueda y refresco: el refresco va a la izquierda de la caja.
        # El bloque entero se oculta (colapsando su ancho) en los ajustes.
        BoxLayout:
            id: header_tools
            size_hint: None, None
            width: dp(288) if root.show_filters else 0
            height: dp(38)
            spacing: dp(10)
            opacity: 1 if root.show_filters else 0
            disabled: not root.show_filters
            pos_hint: {"center_y": .5}
            HoverButton:
                size_hint: None, None
                size: dp(38), dp(38)
                text: icons.REFRESH
                tooltip_text: tr("Refresh the list of builds")
                font_name: theme.ICON_FONT
                font_size: sp(16)
                color: theme.TEXT
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                disabled: not root.show_filters
                pos_hint: {"center_y": .5}
                on_release: root.refresh(force=True)
            BoxLayout:
                size_hint: None, None
                width: dp(240)
                height: dp(34)
                pos_hint: {"center_y": .5}
                canvas.before:
                    Color:
                        rgba: theme.FIELD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]
                Label:
                    text: icons.SEARCH
                    font_name: theme.ICON_FONT
                    font_size: sp(13)
                    color: theme.MUTED
                    size_hint_x: None
                    width: dp(32)
                TextInput:
                    id: search_input
                    hint_text: tr("Search...")
                    background_normal: ""
                    background_active: ""
                    background_color: 0, 0, 0, 0
                    foreground_color: theme.TEXT
                    hint_text_color: theme.MUTED
                    cursor_color: theme.ACCENT
                    selection_color: (theme.ACCENT[0], theme.ACCENT[1], theme.ACCENT[2], 0.45)
                    multiline: False
                    disabled: not root.show_filters
                    on_text: root.set_search(self.text)

    # Barra de filtros: fondo gris claro con los botones oscuros encima,
    # al estilo de las pestañas de Blender.
    BoxLayout:
        size_hint_y: None
        # Colapsada e invisible en los ajustes; los hijos se desactivan para
        # que no capturen toques cuando está oculta.
        height: dp(44) if root.show_filters else 0
        opacity: 1 if root.show_filters else 0
        padding: [dp(16), dp(6)]
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: theme.CHROME
            Rectangle:
                pos: self.pos
                size: self.size
        Pill:
            text: tr("All")
            tooltip_text: tr("Filter: all channels")
            state: "down" if root.channel == "all" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("all")
        Pill:
            text: tr("LTS")
            tooltip_text: tr("Filter: LTS only")
            state: "down" if root.channel == "lts" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("lts")
        Pill:
            text: tr("Stable")
            tooltip_text: tr("Filter: stable only")
            state: "down" if root.channel == "stable" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("stable")
        Pill:
            text: tr("LTS + Stable")
            tooltip_text: tr("Filter: LTS and stable")
            state: "down" if root.channel == "lts_stable" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("lts_stable")
        Pill:
            text: tr("Daily")
            tooltip_text: tr("Filter: daily and alpha")
            state: "down" if root.channel == "daily" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("daily")
        Pill:
            text: tr("Experimental")
            tooltip_text: tr("Filter: experimental branches")
            state: "down" if root.channel == "experimental" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("experimental")
        Pill:
            text: tr("Patch")
            tooltip_text: tr("Filter: pull request builds")
            state: "down" if root.channel == "patch" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("patch")
        Widget:
        Pill:
            text: icons.GRID
            tooltip_text: tr("Grid view")
            font_name: theme.ICON_FONT
            font_size: sp(14)
            state: "down" if root.layout_mode == "grid" else "normal"
            disabled: not root.show_filters
            group: "layout"
            on_release: root.set_layout_mode("grid")
        Pill:
            text: icons.LIST
            tooltip_text: tr("List view")
            font_name: theme.ICON_FONT
            font_size: sp(14)
            state: "down" if root.layout_mode == "list" else "normal"
            disabled: not root.show_filters
            group: "layout"
            on_release: root.set_layout_mode("list")
        HoverSpinner:
            text: root.platform_label
            values: root.platform_labels
            tooltip_text: tr("Target operating system")
            size_hint: None, None
            width: dp(104)
            height: dp(32)
            disabled: not root.show_filters
            pos_hint: {"center_y": .5}
            on_text: root.set_platform(self.text)
        HoverSpinner:
            text: root.arch_label
            values: root.arch_labels
            tooltip_text: tr("Target architecture")
            size_hint: None, None
            width: dp(82)
            height: dp(32)
            disabled: not root.show_filters
            pos_hint: {"center_y": .5}
            on_text: root.set_arch(self.text)

    BoxLayout:
        id: body
        orientation: "horizontal"
        BoxLayout:
            size_hint_x: None
            width: dp(74)
            orientation: "vertical"
            padding: [dp(11), dp(14)]
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: theme.SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size
            SideButton:
                text: icons.INSTALLED
                tooltip_text: tr("Show installed versions")
                active: root.view == "installed"
                on_release: root.set_view("installed")
            SideButton:
                text: icons.STORE
                tooltip_text: tr("Show the store")
                active: root.view == "store"
                on_release: root.set_view("store")
            Widget:
            SideButton:
                text: icons.SETTINGS
                tooltip_text: tr("Open settings")
                active: root.view == "settings"
                on_release: root.set_view("settings")

        # Las tres vistas viven en un ScreenManager: solo se dibuja la activa
        # y el cambio se anima con un deslizamiento (como en la versión original).
        ScreenManager:
            id: view_manager
            transition: SlideTransition()

            Screen:
                name: "store"
                ScrollView:
                    id: store_scroll
                    GridLayout:
                        id: store_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        padding: [dp(14), dp(14)]


            Screen:
                name: "installed"
                ScrollView:
                    id: installed_scroll
                    GridLayout:
                        id: installed_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        padding: [dp(14), dp(14)]


            Screen:
                name: "settings"
                BoxLayout:
                    id: settings_panel
                    orientation: "vertical"
                    canvas.before:
                        Color:
                            rgba: theme.BG
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    # Dos columnas de tarjetas con filas compactas: así entra
                    # todo sin scroll. La columna izquierda agrupa lo general y
                    # la derecha el lanzamiento y las actualizaciones.
                    ScrollView:
                        id: settings_scroll
                        BoxLayout:
                            id: settings_content
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(16)
                            padding: [max(dp(24), (self.width - dp(860)) / 2), dp(20)]

                            BoxLayout:
                                size_hint_y: None
                                height: dp(34)
                                spacing: dp(10)
                                Label:
                                    text: icons.SETTINGS
                                    font_name: theme.ICON_FONT
                                    font_size: sp(18)
                                    color: theme.TEXT
                                    size_hint_x: None
                                    width: dp(24)
                                    halign: "left"
                                    valign: "middle"
                                    text_size: self.size
                                Label:
                                    text: tr("Settings")
                                    font_size: sp(20)
                                    bold: True
                                    color: theme.TEXT
                                    halign: "left"
                                    valign: "middle"
                                    text_size: self.size
                                Widget:
                                CardButton:
                                    text: tr("Save")
                                    size_hint_x: None
                                    width: dp(120)
                                    pos_hint: {"center_y": .5}
                                    button_color: theme.ACCENT
                                    pressed_color: theme.ACCENT_DARK
                                    use_gradient: True
                                    on_release: root.save_settings(dest_input.text, language_spinner.text, archive_switch.active, args_input.text)

                            BoxLayout:
                                orientation: "horizontal"
                                size_hint_y: None
                                height: max(col_left.height, col_right.height)
                                spacing: dp(16)

                                # --- Columna izquierda: General ---
                                GridLayout:
                                    id: col_left
                                    cols: 1
                                    size_hint_x: 1
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(16)
                                    pos_hint: {"top": 1}
                                    SettingsCard:
                                        SettingsHeader:
                                            icon: icons.FOLDER
                                            title: tr("General")
                                        SettingsFieldLabel:
                                            text: tr("Destination folder")
                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(38)
                                            spacing: dp(8)
                                            SettingsInput:
                                                TextInput:
                                                    id: dest_input
                                                    text: root.dest_folder
                                                    background_normal: ""
                                                    background_active: ""
                                                    background_color: 0, 0, 0, 0
                                                    foreground_color: theme.TEXT
                                                    cursor_color: theme.ACCENT
                                                    selection_color: (theme.ACCENT[0], theme.ACCENT[1], theme.ACCENT[2], 0.45)
                                                    multiline: False
                                                    # Rutas largas: se veia el
                                                    # final y no la carpeta.
                                                    on_text: root.reset_input_scroll(self)
                                            CardButton:
                                                text: tr("Browse...")
                                                tooltip_text: tr("Choose destination folder")
                                                size_hint_x: None
                                                width: dp(104)
                                                on_release: root.browse_dest()
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Delete archive after extraction")
                                            SwitchPill:
                                                id: archive_switch
                                                text: tr("Yes") if self.active else tr("No")
                                                active: root.delete_archive
                                                tooltip_text: tr("Delete archive after extraction")
                                                pos_hint: {"center_y": .5}
                                                on_release: root.delete_archive = self.active
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Language")
                                            HoverSpinner:
                                                id: language_spinner
                                                text: root.language_label
                                                values: root.language_values()
                                                size_hint: None, None
                                                size: dp(190), dp(30)
                                                pos_hint: {"center_y": .5}

                                # --- Columna derecha: Lanzamiento y Updates ---
                                GridLayout:
                                    id: col_right
                                    cols: 1
                                    size_hint_x: 1
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(16)
                                    pos_hint: {"top": 1}
                                    SettingsCard:
                                        SettingsHeader:
                                            icon: icons.LAUNCH
                                            title: tr("Launch options")
                                        SettingsFieldLabel:
                                            text: tr("Launch arguments")
                                        SettingsInput:
                                            TextInput:
                                                id: args_input
                                                text: root.launch_args
                                                hint_text: "--background --python script.py"
                                                background_normal: ""
                                                background_active: ""
                                                background_color: 0, 0, 0, 0
                                                foreground_color: theme.TEXT
                                                hint_text_color: theme.MUTED
                                                cursor_color: theme.ACCENT
                                                selection_color: (theme.ACCENT[0], theme.ACCENT[1], theme.ACCENT[2], 0.45)
                                                multiline: False
                                    SettingsCard:
                                        SettingsHeader:
                                            icon: icons.REFRESH
                                            title: tr("Updates")
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Check for updates automatically")
                                            SwitchPill:
                                                id: update_switch
                                                text: tr("Yes") if self.active else tr("No")
                                                active: root.auto_update
                                                tooltip_text: tr("Check for updates automatically")
                                                pos_hint: {"center_y": .5}
                                                on_release: root.set_auto_update(self.active)
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Version {version}", version=root.current_version)
                                                color: theme.MUTED
                                            CardButton:
                                                text: tr("Check now")
                                                size_hint_x: None
                                                width: dp(130)
                                                tooltip_text: tr("Check for updates now")
                                                pos_hint: {"center_y": .5}
                                                on_release: root.check_updates(True)


    BoxLayout:
        size_hint_y: None
        height: dp(40)
        padding: [dp(16), dp(4)]
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: theme.SURFACE
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: root.status_text
            color: theme.MUTED
            font_size: sp(12)
            size_hint_x: None
            # Mientras se descarga cede sitio a la barra: con un ancho fijo de
            # 470 px la barra se quedaba en un cuadradito en ventanas estrechas.
            width: min(dp(470), max(dp(150), self.parent.width * (0.34 if root.downloading else 0.62)))
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
        AppProgressBar:
            id: progress_bar
            max: 100
            value: root.progress
            height: dp(12)
            size_hint_y: None
            pos_hint: {"center_y": .5}
            # Solo se muestra mientras hay una descarga en curso.
            opacity: 1 if root.downloading else 0
            disabled: not root.downloading
        Label:
            text: "{:.0f} %".format(root.progress)
            color: theme.TEXT
            font_size: sp(12)
            size_hint_x: None
            width: dp(42) if root.downloading else 0
            opacity: 1 if root.downloading else 0
            halign: "right"
            valign: "middle"
            text_size: self.size
        CardButton:
            text: tr("Cancel")
            size_hint_x: None
            width: dp(100)
            height: dp(30)
            opacity: 1 if root.downloading else 0
            disabled: not root.downloading
            on_release: root.cancel_download()
        # Barra de zoom: solo en modo rejilla y fuera de los ajustes.
        # El bloque se oculta colapsando su ancho en los demás casos.
        BoxLayout:
            id: zoom_box
            size_hint_x: None
            width: dp(130) if root.show_zoom else 0
            opacity: 1 if root.show_zoom else 0
            disabled: not root.show_zoom
            ZoomSlider:
                id: zoom_slider
                min: 0.6
                max: 1.8
                value: root.zoom
                disabled: not root.show_zoom
                on_value: root.set_zoom(self.value)
