# Interfaz declarativa de Blender Manager (Kivy Language).
# La lógica está en src/ui/widgets.py; aquí solo se describe el aspecto.
#
# Orden del archivo:
#   1. Estilos de botones (Pill, SideButton, CardButton).
#   2. Tarjetas de compilación (BuildCard, GridBuildCard, InstalledCard).
#   3. Pantalla principal (RootWidget): cabecera, filtros, listas y pie.

#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import theme ui.theme
#:import icons ui.icons
#:import tr i18n.tr
#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# Los botones comparten tres capas de dibujo: relleno, degradado superior
# (volumen) y un borde fino. `self.hovered` (de HoverBehavior) resalta el
# elemento bajo el ratón con el azul de selección.

# --- Botón tipo pastilla (filtros de canal, selector de vista) ---
<Pill>:
    size_hint: None, None
    height: dp(30)
    width: self.texture_size[0] + dp(26)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT_SEL if (self.state == "down" or self.hovered) else theme.TEXT
    font_size: sp(13)
    bold: True
    allow_no_selection: False
    canvas.before:
        Color:
            rgba: theme.ACCENT if self.state == "down" else (theme.ACCENT_DARK if self.hovered else theme.FILTER)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(6))
            width: 1

<SideButton>:
    size_hint: None, None
    size: dp(50), dp(50)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    font_name: theme.ICON_FONT
    font_size: sp(20)
    color: theme.TEXT_SEL if (self.state == "down" or self.hovered) else theme.TEXT
    allow_no_selection: False
    canvas.before:
        Color:
            rgba: theme.ACCENT if self.state == "down" else (theme.ACCENT_DARK if self.hovered else theme.BUTTON)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(8))
            width: 1

<CardButton>:
    size_hint: None, None
    height: dp(36)
    width: dp(118)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    font_size: sp(13)
    bold: True
    canvas.before:
        Color:
            rgba: self.pressed_color if self.state == "down" else ((min(1.0, self.button_color[0] * 1.22), min(1.0, self.button_color[1] * 1.22), min(1.0, self.button_color[2] * 1.22), 1) if (self.hovered and not self.disabled) else self.button_color)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]
        Color:
            rgba: 1, 1, 1, (1 if self.use_gradient else 0)
        RoundedRectangle:
            texture: theme.GRADIENT_TOP
            pos: self.pos
            size: self.size
            radius: [dp(5)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(5))
            width: 1

# --- Interruptor de sí/no con el mismo aspecto que los botones ---
<SwitchPill>:
    size_hint: None, None
    height: dp(28)
    width: dp(64)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT_SEL if (self.active or self.hovered) else theme.TEXT
    font_size: sp(12)
    bold: True
    canvas.before:
        Color:
            rgba: theme.ACCENT if self.active else (theme.ACCENT_DARK if self.hovered else theme.BUTTON)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(6))
            width: 1

# --- Barra de zoom propia (pista, relleno y tirador redondeado) ---
<ZoomSlider>:
    size_hint: None, None
    width: dp(130)
    height: dp(28)
    canvas:
        Color:
            rgba: theme.FIELD
        RoundedRectangle:
            pos: self.x, self.center_y - dp(2)
            size: self.width, dp(4)
            radius: [dp(2)]
        Color:
            rgba: theme.ACCENT
        RoundedRectangle:
            pos: self.x, self.center_y - dp(2)
            size: max(0, self.thumb_x + self.thumb_size / 2 - self.x), dp(4)
            radius: [dp(2)]
        Color:
            rgba: theme.ACCENT if (self.hovered or self.dragging) else theme.BUTTON
        RoundedRectangle:
            pos: self.thumb_x, self.center_y - self.thumb_size / 2
            size: self.thumb_size, self.thumb_size
            radius: [self.thumb_size / 2]
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            texture: theme.GRADIENT_TOP
            pos: self.thumb_x, self.center_y - self.thumb_size / 2
            size: self.thumb_size, self.thumb_size
            radius: [self.thumb_size / 2]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.thumb_x + 0.5, self.center_y - self.thumb_size / 2 + 0.5, self.thumb_size - 1, self.thumb_size - 1, self.thumb_size / 2)
            width: 1

# --- Desplegables oscuros (estilo Blender) ---
<HoverSpinner>:
    size_hint: None, None
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    font_size: sp(12)
    option_cls: "DarkSpinnerOption"
    canvas.before:
        Color:
            rgba: theme.ACCENT_DARK if (self.hovered or self.is_open) else theme.FILTER
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(5))
            width: 1
    Label:
        text: icons.CHEVRON
        font_name: theme.ICON_FONT
        font_size: sp(10)
        color: theme.MUTED
        size_hint: None, None
        size: dp(12), dp(12)
        pos: (self.parent.right - self.width - dp(5), self.parent.center_y - self.height / 2)

<DarkSpinnerOption>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    font_size: sp(12)
    canvas.before:
        Color:
            rgba: theme.ACCENT if (self.state == "down" or self.hovered) else theme.FIELD
        Rectangle:
            pos: self.pos
            size: self.size

# --- Tarjeta en modo lista: una compilación por fila ---
<BuildCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(78)
    padding: [dp(16), dp(11), dp(12), dp(11)]
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else (theme.SURFACE if root.installed else (0.125, 0.125, 0.125, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(44), dp(44)
        pos_hint: {"center_y": .5}
        opacity: 1 if root.installed else 0.32
        allow_stretch: True
        keep_ratio: True

    BoxLayout:
        orientation: "vertical"
        spacing: dp(3)
        opacity: 1 if root.installed else 0.45
        BoxLayout:
            size_hint_y: None
            height: dp(24)
            spacing: dp(10)
            Label:
                text: "Blender " + root.version_text
                color: theme.TEXT
                font_size: sp(16)
                bold: True
                size_hint_x: None
                width: self.texture_size[0]
                valign: "middle"
            Label:
                text: root.channel_text
                color: theme.WARNING if root.is_lts else theme.INFO_TEXT
                font_size: sp(12)
                bold: True
                size_hint_x: None
                width: self.texture_size[0]
                valign: "middle"
            Widget:
        Label:
            text: root.meta_text
            color: theme.MUTED
            font_size: sp(12)
            halign: "left"
            valign: "middle"
            text_size: self.width, None
            shorten: True

    BoxLayout:
        size_hint_x: None
        width: dp(124)
        orientation: "vertical"
        spacing: dp(2)
        Label:
            text: tr("Installed build") if root.installed else ""
            color: theme.SUCCESS_TEXT
            bold: True
            font_size: sp(12)
        CardButton:
            text: (("[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  ") + root.action_text) if root.installed else root.action_text
            markup: True
            tooltip_text: tr("Launch this installed version") if root.installed else tr("Download and install this version")
            button_color: theme.FILTER if root.installed else theme.ACCENT
            pressed_color: theme.SURFACE_ALT if root.installed else theme.ACCENT_DARK
            use_gradient: True
            on_release: root.owner.install_build(root.build)

# --- Tarjeta en rejilla: icono grande y botón debajo (escala con el zoom) ---
<GridBuildCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(196) * root.zoom
    padding: [dp(12) * root.zoom, dp(14) * root.zoom]
    spacing: dp(6) * root.zoom
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else (theme.SURFACE if root.installed else (0.125, 0.125, 0.125, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(68) * root.zoom, dp(68) * root.zoom
        pos_hint: {"center_x": .5}
        opacity: 1 if root.installed else 0.32
        allow_stretch: True
        keep_ratio: True

    Label:
        text: "Blender " + root.version_text
        color: theme.TEXT
        font_size: sp(15) * root.zoom
        bold: True
        opacity: 1 if root.installed else 0.45
        size_hint_y: None
        height: dp(22) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size

    Label:
        text: root.channel_text + ("  ·  " + root.meta_text if root.meta_text else "")
        color: theme.WARNING if root.is_lts else theme.INFO_TEXT
        font_size: sp(11) * root.zoom
        opacity: 1 if root.installed else 0.45
        size_hint_y: None
        height: dp(18) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size

    Label:
        text: tr("Installed build") if root.installed else ""
        color: theme.SUCCESS_TEXT
        bold: True
        font_size: sp(12) * root.zoom
        size_hint_y: None
        height: dp(16) * root.zoom
        halign: "center"

    Widget:

    CardButton:
        text: (("[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  ") + root.action_text) if root.installed else root.action_text
        markup: True
        tooltip_text: tr("Launch this installed version") if root.installed else tr("Download and install this version")
        button_color: theme.FILTER if root.installed else theme.ACCENT
        pressed_color: theme.SURFACE_ALT if root.installed else theme.ACCENT_DARK
        use_gradient: True
        font_size: sp(13) * root.zoom
        size_hint: (None, None)
        # El ancho se adapta a la celda para no salirse, con un mínimo legible.
        width: max(dp(84), min(dp(150) * root.zoom, self.parent.width - dp(24)))
        height: dp(34) * root.zoom
        pos_hint: {"center_x": .5}
        on_release: root.owner.install_build(root.build)

# --- Tarjeta de una versión ya instalada (lanzar / desinstalar) ---
# Es responsiva: el bloque de texto se estira y se recorta con "…", mientras
# que los botones tienen un ancho fijo reducido para no salirse de la ventana.
<InstalledCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(66)
    padding: [dp(14), dp(10), dp(12), dp(10)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else theme.SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(40), dp(40)
        pos_hint: {"center_y": .5}
        allow_stretch: True
        keep_ratio: True

    BoxLayout:
        orientation: "vertical"
        spacing: dp(2)
        size_hint_x: 1
        Label:
            text: root.title
            color: theme.TEXT
            font_size: sp(15)
            bold: True
            halign: "left"
            valign: "middle"
            text_size: self.width, None
            shorten: True
        Label:
            text: root.meta_text
            color: theme.MUTED
            font_size: sp(11)
            halign: "left"
            valign: "middle"
            text_size: self.width, None
            shorten: True

    CardButton:
        text: "[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  " + root.action_text
        markup: True
        tooltip_text: tr("Launch this installed version")
        button_color: theme.FILTER
        pressed_color: theme.SURFACE_ALT
        disabled: not root.can_launch
        size_hint: (None, None)
        width: dp(104)
        on_release: root.owner.launch_installed(root.entry)

    CardButton:
        text: icons.DELETE
        font_name: theme.ICON_FONT
        font_size: sp(15)
        tooltip_text: tr("Remove this installed version")
        button_color: theme.DANGER
        pressed_color: theme.DANGER_DARK
        use_gradient: True
        size_hint: (None, None)
        width: dp(46)
        on_release: root.owner.delete_installed(root.entry)

# --- Versión instalada en cuadrícula (icono grande y botones debajo) ---
<GridInstalledCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(188) * root.zoom
    padding: [dp(12) * root.zoom, dp(14) * root.zoom]
    spacing: dp(6) * root.zoom
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else theme.SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(64) * root.zoom, dp(64) * root.zoom
        pos_hint: {"center_x": .5}
        allow_stretch: True
        keep_ratio: True

    Label:
        text: root.title
        color: theme.TEXT
        font_size: sp(14) * root.zoom
        bold: True
        size_hint_y: None
        height: dp(20) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size
        shorten: True

    Label:
        text: root.meta_text
        color: theme.MUTED
        font_size: sp(10) * root.zoom
        size_hint_y: None
        height: dp(16) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size
        shorten: True

    Widget:

    BoxLayout:
        size_hint_y: None
        height: dp(32) * root.zoom
        spacing: dp(6) * root.zoom
        CardButton:
            text: "[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  " + root.action_text
            markup: True
            tooltip_text: tr("Launch this installed version")
            button_color: theme.FILTER
            pressed_color: theme.SURFACE_ALT
            use_gradient: True
            disabled: not root.can_launch
            font_size: sp(12) * root.zoom
            size_hint_x: 1
            height: dp(30) * root.zoom
            on_release: root.owner.launch_installed(root.entry)
        CardButton:
            text: icons.DELETE
            font_name: theme.ICON_FONT
            font_size: sp(14) * root.zoom
            tooltip_text: tr("Remove this installed version")
            button_color: theme.DANGER
            pressed_color: theme.DANGER_DARK
            use_gradient: True
            size_hint_x: None
            width: dp(42) * root.zoom
            height: dp(30) * root.zoom
            on_release: root.owner.delete_installed(root.entry)

# --- Pantalla principal ---
# Cabecera (logo, título, búsqueda y actualizar), barra de filtros, cuerpo con
# barra lateral + vistas (tienda/instaladas/ajustes) y pie con estado y zoom.
<RootWidget>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: theme.BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(64)
        padding: [dp(16), dp(10), dp(16), dp(6)]
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: theme.CHROME
            Rectangle:
                pos: self.pos
                size: self.size
        Image:
            source: "images/blender_logo.png"
            size_hint: (None, None)
            size: dp(42), dp(42)
            pos_hint: {"center_y": .5}
            allow_stretch: True
            keep_ratio: True
        Label:
            text: tr("Blender Downloads Manager")
            font_size: sp(19)
            bold: True
            color: theme.TEXT
            size_hint_x: None
            width: self.texture_size[0]
            pos_hint: {"center_y": .5}
        Widget:
        BoxLayout:
            size_hint: None, None
            width: dp(240)
            height: dp(34)
            pos_hint: {"center_y": .5}
            canvas.before:
                Color:
                    rgba: theme.FIELD
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(8)]
            Label:
                text: icons.SEARCH
                font_name: theme.ICON_FONT
                font_size: sp(13)
                color: theme.MUTED
                size_hint_x: None
                width: dp(32)
            TextInput:
                id: search_input
                hint_text: tr("Search...")
                background_normal: ""
                background_active: ""
                background_color: 0, 0, 0, 0
                foreground_color: theme.TEXT
                hint_text_color: theme.MUTED
                cursor_color: theme.ACCENT
                multiline: False
                on_text: root.set_search(self.text)
        HoverButton:
            size_hint: None, None
            size: dp(38), dp(38)
            text: icons.REFRESH
            tooltip_text: tr("Refresh the list of builds")
            font_name: theme.ICON_FONT
            font_size: sp(16)
            color: theme.TEXT
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            pos_hint: {"center_y": .5}
            on_release: root.refresh(force=True)

    # Barra de filtros: fondo gris claro con los botones oscuros encima,
    # al estilo de las pestañas de Blender.
    BoxLayout:
        size_hint_y: None
        height: dp(44)
        padding: [dp(16), dp(6)]
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: theme.CHROME
            Rectangle:
                pos: self.pos
                size: self.size
        Pill:
            text: tr("All")
            tooltip_text: tr("Filter: all channels")
            state: "down" if root.channel == "all" else "normal"
            on_release: root.set_channel("all")
        Pill:
            text: tr("LTS")
            tooltip_text: tr("Filter: LTS only")
            state: "down" if root.channel == "lts" else "normal"
            on_release: root.set_channel("lts")
        Pill:
            text: tr("Stable")
            tooltip_text: tr("Filter: stable only")
            state: "down" if root.channel == "stable" else "normal"
            on_release: root.set_channel("stable")
        Pill:
            text: tr("LTS + Stable")
            tooltip_text: tr("Filter: LTS and stable")
            state: "down" if root.channel == "lts_stable" else "normal"
            on_release: root.set_channel("lts_stable")
        Pill:
            text: tr("Daily")
            tooltip_text: tr("Filter: daily and alpha")
            state: "down" if root.channel == "daily" else "normal"
            on_release: root.set_channel("daily")
        Widget:
        Pill:
            text: icons.GRID
            tooltip_text: tr("Grid view")
            font_name: theme.ICON_FONT
            font_size: sp(14)
            state: "down" if root.layout_mode == "grid" else "normal"
            on_release: root.set_layout_mode("grid")
        Pill:
            text: icons.LIST
            tooltip_text: tr("List view")
            font_name: theme.ICON_FONT
            font_size: sp(14)
            state: "down" if root.layout_mode == "list" else "normal"
            on_release: root.set_layout_mode("list")
        HoverSpinner:
            text: root.platform_label
            values: root.platform_labels
            tooltip_text: tr("Target operating system")
            size_hint: None, None
            width: dp(118)
            height: dp(32)
            pos_hint: {"center_y": .5}
            background_normal: ""
            background_down: ""
            background_color: theme.BUTTON
            color: theme.TEXT
            font_size: sp(12)
            on_text: root.set_platform(self.text)
        HoverSpinner:
            text: root.arch_label
            values: root.arch_labels
            tooltip_text: tr("Target architecture")
            size_hint: None, None
            width: dp(96)
            height: dp(32)
            pos_hint: {"center_y": .5}
            background_normal: ""
            background_down: ""
            background_color: theme.BUTTON
            color: theme.TEXT
            font_size: sp(12)
            on_text: root.set_arch(self.text)

    BoxLayout:
        id: body
        orientation: "horizontal"
        BoxLayout:
            size_hint_x: None
            width: dp(74)
            orientation: "vertical"
            padding: [dp(11), dp(14)]
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: theme.SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size
            SideButton:
                text: icons.INSTALLED
                tooltip_text: tr("Show installed versions")
                state: "down" if root.view == "installed" else "normal"
                on_release: root.set_view("installed")
            SideButton:
                text: icons.STORE
                tooltip_text: tr("Show the store")
                state: "down" if root.view == "store" else "normal"
                on_release: root.set_view("store")
            Widget:
            SideButton:
                text: icons.SETTINGS
                tooltip_text: tr("Open settings")
                state: "down" if root.view == "settings" else "normal"
                on_release: root.set_view("settings")

        # Las tres vistas viven en un ScreenManager: solo se dibuja la activa
        # y el cambio se anima con un deslizamiento (como en la versión original).
        ScreenManager:
            id: view_manager
            transition: SlideTransition()

            Screen:
                name: "store"
                ScrollView:
                    id: store_scroll
                    GridLayout:
                        id: store_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        padding: [dp(14), dp(14)]


            Screen:
                name: "installed"
                ScrollView:
                    id: installed_scroll
                    GridLayout:
                        id: installed_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        padding: [dp(14), dp(14)]


            Screen:
                name: "settings"
                BoxLayout:
                    id: settings_panel
                    orientation: "vertical"
                    padding: dp(22)
                    spacing: dp(12)
                    canvas.before:
                        Color:
                            rgba: theme.SURFACE
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: tr("Destination folder")
                        color: theme.TEXT
                        size_hint_y: None
                        height: dp(22)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)
                        TextInput:
                            id: dest_input
                            text: root.dest_folder
                            background_normal: ""
                            background_active: ""
                            background_color: theme.FIELD
                            foreground_color: theme.TEXT
                            cursor_color: theme.ACCENT
                            padding: [dp(10), dp(10)]
                            multiline: False
                        CardButton:
                            text: tr("Browse...")
                            tooltip_text: tr("Choose destination folder")
                            width: dp(120)
                            on_release: root.browse_dest()
                    Label:
                        text: tr("Language")
                        color: theme.TEXT
                        size_hint_y: None
                        height: dp(22)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    HoverSpinner:
                        id: language_spinner
                        text: root.language_label
                        values: root.language_values()
                        size_hint_x: 1
                        height: dp(38)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        Label:
                            text: tr("Delete archive after extraction")
                            color: theme.TEXT
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                        SwitchPill:
                            id: archive_switch
                            text: tr("Yes") if self.active else tr("No")
                            active: root.delete_archive
                            tooltip_text: tr("Delete archive after extraction")
                            on_release: root.delete_archive = self.active
                    Label:
                        text: tr("Launch arguments")
                        color: theme.TEXT
                        size_hint_y: None
                        height: dp(22)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    TextInput:
                        id: args_input
                        text: root.launch_args
                        hint_text: "--background --python script.py"
                        background_normal: ""
                        background_active: ""
                        background_color: theme.FIELD
                        foreground_color: theme.TEXT
                        hint_text_color: theme.MUTED
                        cursor_color: theme.ACCENT
                        padding: [dp(10), dp(10)]
                        size_hint_y: None
                        height: dp(40)
                        multiline: False
                    Widget:
                    CardButton:
                        text: tr("Save")
                        size_hint_x: None
                        width: dp(140)
                        pos_hint: {"right": 1}
                        on_release: root.save_settings(dest_input.text, language_spinner.text, archive_switch.active, args_input.text)


    BoxLayout:
        size_hint_y: None
        height: dp(44)
        padding: [dp(16), dp(6)]
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: theme.SURFACE
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: root.status_text
            color: theme.MUTED
            font_size: sp(12)
            size_hint_x: None
            width: dp(360)
            halign: "left"
            valign: "middle"
            text_size: self.size
        ProgressBar:
            id: progress_bar
            max: 100
            value: root.progress
            # Solo se muestra mientras hay una descarga en curso.
            opacity: 1 if root.downloading else 0
            disabled: not root.downloading
        CardButton:
            text: tr("Cancel")
            size_hint_x: None
            width: dp(100)
            height: dp(30)
            opacity: 1 if root.downloading else 0
            disabled: not root.downloading
            on_release: root.cancel_download()
        Label:
            text: icons.MINUS
            font_name: theme.ICON_FONT
            font_size: sp(13)
            color: theme.MUTED
            size_hint_x: None
            width: dp(20)
        ZoomSlider:
            id: zoom_slider
            min: 0.6
            max: 1.8
            value: root.zoom
            on_value: root.set_zoom(self.value)
        Label:
            text: icons.PLUS
            font_name: theme.ICON_FONT
            font_size: sp(13)
            color: theme.MUTED
            size_hint_x: None
            width: dp(20)
