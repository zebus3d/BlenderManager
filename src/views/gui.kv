# Interfaz declarativa de Blender Manager (Kivy Language).
# La lógica está en src/ui/widgets.py; aquí solo se describe el aspecto.
#
# Orden del archivo:
#   1. Estilos de botones (Pill, SideButton, CardButton).
#   2. Tarjetas de compilación (BuildCard, GridBuildCard, InstalledCard).
#   3. Pantalla principal (RootWidget): cabecera, filtros, listas y pie.

#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import theme ui.theme
#:import icons ui.icons
#:import tr i18n.tr
#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# Los botones comparten tres capas de dibujo: relleno, degradado superior
# (volumen) y un borde fino. `self.hovered` (de HoverBehavior) resalta el
# elemento bajo el ratón con el azul de selección.

# --- Botón tipo pastilla (filtros de canal, selector de vista) ---
<Pill>:
    size_hint: None, None
    height: dp(30)
    width: self.texture_size[0] + dp(26)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT_SEL if (self.state == "down" or self.hovered) else theme.TEXT
    font_size: sp(13)
    bold: True
    # OJO: allow_no_selection solo lo respeta Kivy si el botón está en un
    # `group` (ToggleButtonBehavior._do_press lo comprueba). Sin grupo, volver
    # a pulsar el filtro activo lo apagaba y ya no se volvía a encender,
    # porque la regla `state:` de abajo solo se reevalúa cuando cambia
    # root.channel. Por eso cada conjunto de pastillas lleva su `group`.
    allow_no_selection: False
    canvas.before:
        Color:
            rgba: theme.ACCENT if self.state == "down" else (theme.ACCENT_DARK if self.hovered else theme.FILTER)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(6))
            width: 1

<SideButton>:
    size_hint: None, None
    size: dp(50), dp(50)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    font_name: theme.ICON_FONT
    font_size: sp(20)
    color: theme.TEXT_SEL if (self.active or self.hovered) else theme.TEXT
    canvas.before:
        Color:
            rgba: theme.ACCENT if self.active else (theme.ACCENT_DARK if self.hovered else theme.BUTTON)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(8))
            width: 1

# Icono de informacion de una tarjeta: el clasico circulo azul con la "i"
# blanca. El circulo se pinta aqui (la fuente de iconos es de un solo color) y
# encima va el glifo, para que se lea igual de bien en grande y en pequeno.
<IconLinkButton>:
    size_hint: None, None
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    font_name: theme.ICON_FONT
    color: theme.TEXT_SEL
    # Diametro del circulo: el lado menor del boton, con un pelin de margen.
    disc: min(self.width, self.height) - dp(3)
    canvas.before:
        Color:
            rgba: theme.ACCENT if (self.hovered or self.state == "down") else theme.INFO_DISC
        Ellipse:
            pos: self.center_x - self.disc / 2.0, self.center_y - self.disc / 2.0
            size: self.disc, self.disc

<CardButton>:
    size_hint: None, None
    height: dp(36)
    width: dp(118)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    font_size: sp(13)
    bold: True
    canvas.before:
        Color:
            rgba: self.pressed_color if self.state == "down" else ((min(1.0, self.button_color[0] * 1.22), min(1.0, self.button_color[1] * 1.22), min(1.0, self.button_color[2] * 1.22), 1) if (self.hovered and not self.disabled) else self.button_color)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]
        Color:
            rgba: 1, 1, 1, (1 if self.use_gradient else 0)
        RoundedRectangle:
            texture: theme.GRADIENT_TOP
            pos: self.pos
            size: self.size
            radius: [dp(5)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(5))
            width: 1

# --- Fila del selector de carpetas (icono + nombre, resalta al pasar) ---
<FolderRow>:
    size_hint_y: None
    height: dp(34)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    font_size: sp(13)
    halign: "left"
    valign: "middle"
    text_size: self.size
    padding: [dp(32), 0]
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]
    Label:
        text: root.icon
        font_name: theme.ICON_FONT
        font_size: sp(12)
        color: theme.WARNING
        size_hint: None, None
        size: dp(15), dp(15)
        pos: (root.x + dp(10), root.center_y - self.height / 2)

# --- Diálogos y barra de progreso con el aspecto de la app ---
# El Popup y el ProgressBar por defecto de Kivy (título claro, separador azul y
# relleno verde) desentonan con el tema. En vez de pintar un panel nosotros (las
# instrucciones de una regla derivada se añaden *después* de los hijos y los
# taparía), teñimos el fondo redondeado que ModalView ya dibuja.
<AppPopup>:
    background_color: theme.SURFACE
    overlay_color: 0, 0, 0, 0.6
    title_size: sp(15)
    title_color: theme.TEXT
    title_align: "left"
    separator_color: theme.BORDER
    separator_height: dp(1)

<AppModalView>:
    background_color: theme.SURFACE

<AppProgressBar>:
    canvas:
        Color:
            rgba: theme.FIELD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(4)]
        Color:
            rgba: theme.ACCENT
        RoundedRectangle:
            pos: self.pos
            size: (self.width * (self.value / self.max if self.max else 0), self.height)
            radius: [dp(4)]

# --- Barra de desplazamiento (la de Kivy es gris claro y desentona) ---
<ScrollView>:
    bar_color: theme.ACCENT
    bar_inactive_color: (theme.MUTED[0], theme.MUTED[1], theme.MUTED[2], 0.35)
    bar_width: dp(8)
    bar_margin: dp(2)
    # Con "bars" la barra se puede arrastrar con el raton, como en cualquier
    # aplicacion de escritorio; con solo "content" unicamente se podia rodar.
    scroll_type: ["bars", "content"]

# --- Pantalla de ajustes: tarjetas, cabeceras y campos ---
# Tarjeta de sección: mismo lenguaje que las tarjetas de la tienda (panel
# SURFACE elevado sobre la página en BG, esquinas redondeadas y borde sutil).
<SettingsCard>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(16), dp(14)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: theme.SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(10))
            width: 1

# Cabecera de sección dentro de una tarjeta: icono de acento, título en gris y
# una línea fina que rellena el resto.
<SettingsHeader>:
    size_hint_y: None
    height: dp(28)
    spacing: dp(8)
    Label:
        text: root.icon
        font_name: theme.ICON_FONT
        font_size: sp(12)
        color: theme.ACCENT
        size_hint_x: None
        width: dp(16)
        halign: "center"
        valign: "middle"
        text_size: self.size
    Label:
        text: root.title
        font_size: sp(12)
        bold: True
        color: theme.MUTED
        size_hint_x: None
        width: self.texture_size[0]
        valign: "middle"
    Widget:
        size_hint_y: None
        height: dp(1)
        canvas:
            Color:
                rgba: 0, 0, 0, 0.28
            Rectangle:
                pos: self.x, self.center_y - dp(0.5)
                size: self.width, dp(1)

# Fila de ajuste: etiqueta a la izquierda y control a la derecha, con un
# separador fino debajo (así las filas se leen como una lista).
<SettingsRow@BoxLayout>:
    size_hint_y: None
    height: dp(46)
    spacing: dp(12)
    canvas.after:
        Color:
            rgba: 0, 0, 0, 0.18
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(1)

# Etiqueta de una fila (ocupa el alto de la fila).
<SettingsRowLabel@Label>:
    font_size: sp(13)
    color: theme.TEXT
    halign: "left"
    valign: "middle"
    text_size: self.size

# Etiqueta encima de un campo de texto (más pequeña y apagada).
<SettingsFieldLabel@Label>:
    size_hint_y: None
    height: dp(18)
    font_size: sp(12)
    color: theme.MUTED
    halign: "left"
    valign: "middle"
    text_size: self.size

# Envoltorio redondeado de un campo de texto, igual que el buscador.
<SettingsInput>:
    size_hint_y: None
    height: dp(38)
    padding: [dp(12), 0]
    canvas.before:
        Color:
            rgba: theme.FIELD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

# --- Interruptor de sí/no con el mismo aspecto que los botones ---
<SwitchPill>:
    size_hint: None, None
    height: dp(28)
    width: dp(64)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT_SEL if (self.active or self.hovered) else theme.TEXT
    font_size: sp(12)
    bold: True
    canvas.before:
        Color:
            rgba: theme.ACCENT if self.active else (theme.ACCENT_DARK if self.hovered else theme.BUTTON)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(6))
            width: 1

# --- Barra de zoom propia (pista, relleno y tirador redondeado) ---
<ZoomSlider>:
    size_hint: None, None
    width: dp(130)
    height: dp(28)
    canvas:
        Color:
            rgba: theme.FIELD
        RoundedRectangle:
            pos: self.x, self.center_y - dp(2)
            size: self.width, dp(4)
            radius: [dp(2)]
        Color:
            rgba: theme.ACCENT
        RoundedRectangle:
            pos: self.x, self.center_y - dp(2)
            size: max(0, self.thumb_x + self.thumb_size / 2 - self.x), dp(4)
            radius: [dp(2)]
        Color:
            rgba: theme.ACCENT if (self.hovered or self.dragging) else theme.BUTTON
        RoundedRectangle:
            pos: self.thumb_x, self.center_y - self.thumb_size / 2
            size: self.thumb_size, self.thumb_size
            radius: [self.thumb_size / 2]
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            texture: theme.GRADIENT_TOP
            pos: self.thumb_x, self.center_y - self.thumb_size / 2
            size: self.thumb_size, self.thumb_size
            radius: [self.thumb_size / 2]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.thumb_x + 0.5, self.center_y - self.thumb_size / 2 + 0.5, self.thumb_size - 1, self.thumb_size - 1, self.thumb_size / 2)
            width: 1

# --- Desplegables oscuros (estilo Blender) ---
<HoverSpinner>:
    size_hint: None, None
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    font_size: sp(12)
    option_cls: "DarkSpinnerOption"
    dropdown_cls: "AppDropDown"
    canvas.before:
        Color:
            rgba: theme.ACCENT_DARK if (self.hovered or self.is_open) else theme.FILTER
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]
        Color:
            rgba: 0, 0, 0, 0.35
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(5))
            width: 1
    Label:
        text: icons.CHEVRON
        font_name: theme.ICON_FONT
        font_size: sp(10)
        color: theme.MUTED
        size_hint: None, None
        size: dp(12), dp(12)
        pos: (self.parent.right - self.width - dp(5), self.parent.center_y - self.height / 2)

# Panel del desplegable: fondo hundido y borde fino, como un menu de Blender.
# Las opciones van transparentes para que se vean sus esquinas redondeadas.
<AppDropDown>:
    # Sin tope, un desplegable largo se saldria de la ventana.
    max_height: dp(240)
    canvas.before:
        Color:
            rgba: theme.SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]
    canvas.after:
        Color:
            rgba: theme.SURFACE_ALT
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(5))
            width: 1

# Fila del desplegable: compacta (la de Kivy mide 44 px) y resaltada al pasar.
<DarkSpinnerOption>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: theme.TEXT_SEL if (self.state == "down" or self.hovered or self.selected) else theme.TEXT
    font_size: sp(12)
    size_hint_y: None
    height: dp(30)
    canvas.before:
        Color:
            rgba: theme.ACCENT if (self.state == "down" or self.hovered) else (theme.ACCENT_DARK if self.selected else (0, 0, 0, 0))
        Rectangle:
            pos: self.pos
            size: self.size

# --- Tarjeta en modo lista: una compilación por fila ---
<BuildCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(78)
    padding: [dp(16), dp(11), dp(12), dp(11)]
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else self.row_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(44), dp(44)
        pos_hint: {"center_y": .5}
        opacity: 1 if root.installed else 0.32
        allow_stretch: True
        keep_ratio: True

    BoxLayout:
        orientation: "vertical"
        spacing: dp(3)
        BoxLayout:
            size_hint_y: None
            height: dp(24)
            spacing: dp(10)
            Label:
                text: "Blender " + root.version_text
                color: theme.TEXT
                opacity: 1 if root.installed else 0.6
                font_size: sp(16)
                bold: True
                size_hint_x: None
                width: self.texture_size[0]
                valign: "middle"
            Label:
                text: root.channel_text
                color: theme.WARNING if root.is_lts else theme.INFO_TEXT
                opacity: 1 if root.installed else 0.6
                font_size: sp(12)
                bold: True
                size_hint_x: None
                width: self.texture_size[0]
                valign: "middle"
            Widget:
        Label:
            text: root.meta_text
            color: theme.MUTED
            opacity: 1 if root.installed else 0.6
            font_size: sp(12)
            halign: "left"
            valign: "middle"
            text_size: self.width, None
            shorten: True

    IconLinkButton:
        text: icons.INFO
        font_size: sp(13)
        size: dp(22), dp(22)
        # A la altura exacta del boton de la derecha: en las filas instaladas
        # el rotulo "Instalada" lo baja un poco respecto al centro de la fila.
        pos_hint: {"center_y": (action_button.center_y - root.y) / root.height if root.height else .5}
        tooltip_text: tr("Read the release notes for this version")
        on_release: root.owner.open_release_notes(root.version_text)

    BoxLayout:
        size_hint_x: None
        width: dp(124)
        orientation: "vertical"
        spacing: dp(2)
        Label:
            text: tr("Installed build") if root.installed else ""
            color: theme.SUCCESS_TEXT
            bold: True
            font_size: sp(12)
        CardButton:
            id: action_button
            text: (("[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  ") + root.action_text) if root.installed else root.action_text
            markup: True
            tooltip_text: tr("Launch this installed version") if root.installed else tr("Download and install this version")
            button_color: theme.FILTER if root.installed else theme.ACCENT
            pressed_color: theme.SURFACE_ALT if root.installed else theme.ACCENT_DARK
            use_gradient: True
            on_release: root.owner.install_build(root.build)

# --- Tarjeta en rejilla: icono grande y botón debajo (escala con el zoom) ---
<GridBuildCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(196) * root.zoom
    padding: [dp(12) * root.zoom, dp(14) * root.zoom]
    spacing: dp(6) * root.zoom
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else self.row_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(68) * root.zoom, dp(68) * root.zoom
        pos_hint: {"center_x": .5}
        opacity: 1 if root.installed else 0.32
        allow_stretch: True
        keep_ratio: True

    Label:
        text: "Blender " + root.version_text
        color: theme.TEXT
        font_size: sp(15) * root.zoom
        bold: True
        opacity: 1 if root.installed else 0.6
        size_hint_y: None
        height: dp(22) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size
        shorten: True

    Label:
        text: root.channel_text + ("  ·  " + root.meta_text if root.meta_text else "")
        color: theme.WARNING if root.is_lts else theme.INFO_TEXT
        font_size: sp(11) * root.zoom
        opacity: 1 if root.installed else 0.6
        size_hint_y: None
        height: dp(18) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size

    Label:
        text: tr("Installed build") if root.installed else ""
        color: theme.SUCCESS_TEXT
        bold: True
        font_size: sp(12) * root.zoom
        size_hint_y: None
        height: dp(16) * root.zoom
        halign: "center"

    Widget:

    # Fila de accion: la "i" de las notas de version a la izquierda del boton.
    BoxLayout:
        size_hint_y: None
        height: dp(34) * root.zoom
        spacing: dp(6) * root.zoom
        Widget:
        IconLinkButton:
            text: icons.INFO
            font_size: sp(12) * root.zoom
            size_hint: (None, None)
            size: dp(20) * root.zoom, dp(20) * root.zoom
            pos_hint: {"center_y": .5}
            tooltip_text: tr("Read the release notes for this version")
            on_release: root.owner.open_release_notes(root.version_text)
        CardButton:
            text: (("[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  ") + root.action_text) if root.installed else root.action_text
            markup: True
            tooltip_text: tr("Launch this installed version") if root.installed else tr("Download and install this version")
            button_color: theme.FILTER if root.installed else theme.ACCENT
            pressed_color: theme.SURFACE_ALT if root.installed else theme.ACCENT_DARK
            use_gradient: True
            font_size: sp(13) * root.zoom
            size_hint: (None, None)
            # El ancho se adapta a la celda para no salirse, con un minimo legible.
            width: max(dp(84), min(dp(150) * root.zoom, root.width - dp(56) * root.zoom))
            height: dp(34) * root.zoom
            pos_hint: {"center_y": .5}
            on_release: root.owner.install_build(root.build)
        Widget:

# --- Tarjeta de una versión ya instalada (lanzar / desinstalar) ---
# Es responsiva: el bloque de texto se estira y se recorta con "…", mientras
# que los botones tienen un ancho fijo reducido para no salirse de la ventana.
<InstalledCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(66)
    padding: [dp(14), dp(10), dp(12), dp(10)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else self.row_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(40), dp(40)
        pos_hint: {"center_y": .5}
        allow_stretch: True
        keep_ratio: True

    BoxLayout:
        orientation: "vertical"
        spacing: dp(2)
        size_hint_x: 1
        Label:
            text: root.title
            color: theme.TEXT
            font_size: sp(15)
            bold: True
            halign: "left"
            valign: "middle"
            text_size: self.width, None
            shorten: True
        Label:
            text: root.meta_text
            color: theme.MUTED
            font_size: sp(11)
            halign: "left"
            valign: "middle"
            text_size: self.width, None
            shorten: True

    IconLinkButton:
        text: icons.INFO
        font_size: sp(13)
        size: dp(22), dp(22)
        pos_hint: {"center_y": .5}
        tooltip_text: tr("Read the release notes for this version")
        on_release: root.owner.open_release_notes(root.version_text)

    CardButton:
        text: "[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  " + root.action_text
        markup: True
        tooltip_text: tr("Launch this installed version")
        button_color: theme.FILTER
        pressed_color: theme.SURFACE_ALT
        disabled: not root.can_launch
        size_hint: (None, None)
        width: dp(104)
        on_release: root.owner.launch_installed(root.entry)

    CardButton:
        text: icons.DELETE
        font_name: theme.ICON_FONT
        font_size: sp(15)
        tooltip_text: tr("Remove this installed version")
        button_color: theme.DANGER
        pressed_color: theme.DANGER_DARK
        use_gradient: True
        size_hint: (None, None)
        width: dp(46)
        on_release: root.owner.delete_installed(root.entry)

# --- Versión instalada en cuadrícula (icono grande y botones debajo) ---
<GridInstalledCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(188) * root.zoom
    padding: [dp(12) * root.zoom, dp(14) * root.zoom]
    spacing: dp(6) * root.zoom
    canvas.before:
        Color:
            rgba: theme.SURFACE_ALT if self.hovered else self.row_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Image:
        source: "images/blender_logo.png"
        size_hint: (None, None)
        size: dp(64) * root.zoom, dp(64) * root.zoom
        pos_hint: {"center_x": .5}
        allow_stretch: True
        keep_ratio: True

    Label:
        text: root.title
        color: theme.TEXT
        font_size: sp(14) * root.zoom
        bold: True
        size_hint_y: None
        height: dp(20) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size
        shorten: True

    Label:
        text: root.meta_text
        color: theme.MUTED
        font_size: sp(10) * root.zoom
        size_hint_y: None
        height: dp(16) * root.zoom
        halign: "center"
        valign: "middle"
        text_size: self.size
        shorten: True

    Widget:

    BoxLayout:
        size_hint_y: None
        height: dp(32) * root.zoom
        spacing: dp(6) * root.zoom
        IconLinkButton:
            text: icons.INFO
            font_size: sp(12) * root.zoom
            size_hint_x: None
            size: dp(20) * root.zoom, dp(20) * root.zoom
            pos_hint: {"center_y": .5}
            tooltip_text: tr("Read the release notes for this version")
            on_release: root.owner.open_release_notes(root.version_text)
        CardButton:
            text: "[color=22c55e][font=Icons]" + icons.LAUNCH + "[/font][/color]  " + root.action_text
            markup: True
            tooltip_text: tr("Launch this installed version")
            button_color: theme.FILTER
            pressed_color: theme.SURFACE_ALT
            use_gradient: True
            disabled: not root.can_launch
            font_size: sp(12) * root.zoom
            size_hint_x: 1
            height: dp(30) * root.zoom
            on_release: root.owner.launch_installed(root.entry)
        CardButton:
            text: icons.DELETE
            font_name: theme.ICON_FONT
            font_size: sp(14) * root.zoom
            tooltip_text: tr("Remove this installed version")
            button_color: theme.DANGER
            pressed_color: theme.DANGER_DARK
            use_gradient: True
            size_hint_x: None
            width: dp(42) * root.zoom
            height: dp(30) * root.zoom
            on_release: root.owner.delete_installed(root.entry)

# --- Pantalla principal ---
# Cabecera (logo, título, búsqueda y actualizar), barra de filtros, cuerpo con
# barra lateral + vistas (tienda/instaladas/ajustes) y pie con estado y zoom.
<RootWidget>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: theme.BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(72)
        padding: [dp(16), dp(10), dp(16), dp(8)]
        spacing: dp(14)
        canvas.before:
            Color:
                rgba: theme.CHROME
            Rectangle:
                pos: self.pos
                size: self.size
        Image:
            source: "images/app_icon.png"
            size_hint: (None, None)
            size: dp(52), dp(52)
            pos_hint: {"center_y": .5}
            allow_stretch: True
            keep_ratio: True
        Label:
            text: tr("Blender Downloads Manager")
            font_size: sp(19)
            bold: True
            color: theme.TEXT
            size_hint_x: None
            width: self.texture_size[0]
            pos_hint: {"center_y": .5}
        Widget:
        # Búsqueda y refresco: el refresco va a la izquierda de la caja.
        # El bloque entero se oculta (colapsando su ancho) en los ajustes.
        BoxLayout:
            id: header_tools
            size_hint: None, None
            width: dp(288) if root.show_filters else 0
            height: dp(38)
            spacing: dp(10)
            opacity: 1 if root.show_filters else 0
            disabled: not root.show_filters
            pos_hint: {"center_y": .5}
            HoverButton:
                size_hint: None, None
                size: dp(38), dp(38)
                text: icons.REFRESH
                tooltip_text: tr("Refresh the list of builds")
                font_name: theme.ICON_FONT
                font_size: sp(16)
                color: theme.TEXT
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                disabled: not root.show_filters
                pos_hint: {"center_y": .5}
                on_release: root.refresh(force=True)
            BoxLayout:
                size_hint: None, None
                width: dp(240)
                height: dp(34)
                pos_hint: {"center_y": .5}
                canvas.before:
                    Color:
                        rgba: theme.FIELD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]
                Label:
                    text: icons.SEARCH
                    font_name: theme.ICON_FONT
                    font_size: sp(13)
                    color: theme.MUTED
                    size_hint_x: None
                    width: dp(32)
                TextInput:
                    id: search_input
                    hint_text: tr("Search...")
                    background_normal: ""
                    background_active: ""
                    background_color: 0, 0, 0, 0
                    foreground_color: theme.TEXT
                    hint_text_color: theme.MUTED
                    cursor_color: theme.ACCENT
                    selection_color: (theme.ACCENT[0], theme.ACCENT[1], theme.ACCENT[2], 0.45)
                    multiline: False
                    disabled: not root.show_filters
                    on_text: root.set_search(self.text)

    # Barra de filtros: fondo gris claro con los botones oscuros encima,
    # al estilo de las pestañas de Blender.
    BoxLayout:
        size_hint_y: None
        # Colapsada e invisible en los ajustes; los hijos se desactivan para
        # que no capturen toques cuando está oculta.
        height: dp(44) if root.show_filters else 0
        opacity: 1 if root.show_filters else 0
        padding: [dp(16), dp(6)]
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: theme.CHROME
            Rectangle:
                pos: self.pos
                size: self.size
        Pill:
            text: tr("All")
            tooltip_text: tr("Filter: all channels")
            state: "down" if root.channel == "all" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("all")
        Pill:
            text: tr("LTS")
            tooltip_text: tr("Filter: LTS only")
            state: "down" if root.channel == "lts" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("lts")
        Pill:
            text: tr("Stable")
            tooltip_text: tr("Filter: stable only")
            state: "down" if root.channel == "stable" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("stable")
        Pill:
            text: tr("LTS + Stable")
            tooltip_text: tr("Filter: LTS and stable")
            state: "down" if root.channel == "lts_stable" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("lts_stable")
        Pill:
            text: tr("Daily")
            tooltip_text: tr("Filter: daily and alpha")
            state: "down" if root.channel == "daily" else "normal"
            disabled: not root.show_filters
            group: "channel"
            on_release: root.set_channel("daily")
        Widget:
        Pill:
            text: icons.GRID
            tooltip_text: tr("Grid view")
            font_name: theme.ICON_FONT
            font_size: sp(14)
            state: "down" if root.layout_mode == "grid" else "normal"
            disabled: not root.show_filters
            group: "layout"
            on_release: root.set_layout_mode("grid")
        Pill:
            text: icons.LIST
            tooltip_text: tr("List view")
            font_name: theme.ICON_FONT
            font_size: sp(14)
            state: "down" if root.layout_mode == "list" else "normal"
            disabled: not root.show_filters
            group: "layout"
            on_release: root.set_layout_mode("list")
        HoverSpinner:
            text: root.platform_label
            values: root.platform_labels
            tooltip_text: tr("Target operating system")
            size_hint: None, None
            width: dp(118)
            height: dp(32)
            disabled: not root.show_filters
            pos_hint: {"center_y": .5}
            on_text: root.set_platform(self.text)
        HoverSpinner:
            text: root.arch_label
            values: root.arch_labels
            tooltip_text: tr("Target architecture")
            size_hint: None, None
            width: dp(96)
            height: dp(32)
            disabled: not root.show_filters
            pos_hint: {"center_y": .5}
            on_text: root.set_arch(self.text)

    BoxLayout:
        id: body
        orientation: "horizontal"
        BoxLayout:
            size_hint_x: None
            width: dp(74)
            orientation: "vertical"
            padding: [dp(11), dp(14)]
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: theme.SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size
            SideButton:
                text: icons.INSTALLED
                tooltip_text: tr("Show installed versions")
                active: root.view == "installed"
                on_release: root.set_view("installed")
            SideButton:
                text: icons.STORE
                tooltip_text: tr("Show the store")
                active: root.view == "store"
                on_release: root.set_view("store")
            Widget:
            SideButton:
                text: icons.SETTINGS
                tooltip_text: tr("Open settings")
                active: root.view == "settings"
                on_release: root.set_view("settings")

        # Las tres vistas viven en un ScreenManager: solo se dibuja la activa
        # y el cambio se anima con un deslizamiento (como en la versión original).
        ScreenManager:
            id: view_manager
            transition: SlideTransition()

            Screen:
                name: "store"
                ScrollView:
                    id: store_scroll
                    GridLayout:
                        id: store_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        padding: [dp(14), dp(14)]


            Screen:
                name: "installed"
                ScrollView:
                    id: installed_scroll
                    GridLayout:
                        id: installed_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        padding: [dp(14), dp(14)]


            Screen:
                name: "settings"
                BoxLayout:
                    id: settings_panel
                    orientation: "vertical"
                    canvas.before:
                        Color:
                            rgba: theme.BG
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    # Dos columnas de tarjetas con filas compactas: así entra
                    # todo sin scroll. La columna izquierda agrupa lo general y
                    # la derecha el lanzamiento y las actualizaciones.
                    ScrollView:
                        id: settings_scroll
                        BoxLayout:
                            id: settings_content
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(16)
                            padding: [max(dp(24), (self.width - dp(860)) / 2), dp(20)]

                            BoxLayout:
                                size_hint_y: None
                                height: dp(34)
                                spacing: dp(10)
                                Label:
                                    text: icons.SETTINGS
                                    font_name: theme.ICON_FONT
                                    font_size: sp(18)
                                    color: theme.TEXT
                                    size_hint_x: None
                                    width: dp(24)
                                    halign: "left"
                                    valign: "middle"
                                    text_size: self.size
                                Label:
                                    text: tr("Settings")
                                    font_size: sp(20)
                                    bold: True
                                    color: theme.TEXT
                                    halign: "left"
                                    valign: "middle"
                                    text_size: self.size
                                Widget:
                                CardButton:
                                    text: tr("Save")
                                    size_hint_x: None
                                    width: dp(120)
                                    pos_hint: {"center_y": .5}
                                    button_color: theme.ACCENT
                                    pressed_color: theme.ACCENT_DARK
                                    use_gradient: True
                                    on_release: root.save_settings(dest_input.text, language_spinner.text, archive_switch.active, args_input.text)

                            BoxLayout:
                                orientation: "horizontal"
                                size_hint_y: None
                                height: max(col_left.height, col_right.height)
                                spacing: dp(16)

                                # --- Columna izquierda: General ---
                                GridLayout:
                                    id: col_left
                                    cols: 1
                                    size_hint_x: 1
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(16)
                                    pos_hint: {"top": 1}
                                    SettingsCard:
                                        SettingsHeader:
                                            icon: icons.FOLDER
                                            title: tr("General")
                                        SettingsFieldLabel:
                                            text: tr("Destination folder")
                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(38)
                                            spacing: dp(8)
                                            SettingsInput:
                                                TextInput:
                                                    id: dest_input
                                                    text: root.dest_folder
                                                    background_normal: ""
                                                    background_active: ""
                                                    background_color: 0, 0, 0, 0
                                                    foreground_color: theme.TEXT
                                                    cursor_color: theme.ACCENT
                                                    selection_color: (theme.ACCENT[0], theme.ACCENT[1], theme.ACCENT[2], 0.45)
                                                    multiline: False
                                                    # Rutas largas: se veia el
                                                    # final y no la carpeta.
                                                    on_text: root.reset_input_scroll(self)
                                            CardButton:
                                                text: tr("Browse...")
                                                tooltip_text: tr("Choose destination folder")
                                                size_hint_x: None
                                                width: dp(104)
                                                on_release: root.browse_dest()
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Delete archive after extraction")
                                            SwitchPill:
                                                id: archive_switch
                                                text: tr("Yes") if self.active else tr("No")
                                                active: root.delete_archive
                                                tooltip_text: tr("Delete archive after extraction")
                                                pos_hint: {"center_y": .5}
                                                on_release: root.delete_archive = self.active
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Language")
                                            HoverSpinner:
                                                id: language_spinner
                                                text: root.language_label
                                                values: root.language_values()
                                                size_hint: None, None
                                                size: dp(190), dp(30)
                                                pos_hint: {"center_y": .5}

                                # --- Columna derecha: Lanzamiento y Updates ---
                                GridLayout:
                                    id: col_right
                                    cols: 1
                                    size_hint_x: 1
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(16)
                                    pos_hint: {"top": 1}
                                    SettingsCard:
                                        SettingsHeader:
                                            icon: icons.LAUNCH
                                            title: tr("Launch options")
                                        SettingsFieldLabel:
                                            text: tr("Launch arguments")
                                        SettingsInput:
                                            TextInput:
                                                id: args_input
                                                text: root.launch_args
                                                hint_text: "--background --python script.py"
                                                background_normal: ""
                                                background_active: ""
                                                background_color: 0, 0, 0, 0
                                                foreground_color: theme.TEXT
                                                hint_text_color: theme.MUTED
                                                cursor_color: theme.ACCENT
                                                selection_color: (theme.ACCENT[0], theme.ACCENT[1], theme.ACCENT[2], 0.45)
                                                multiline: False
                                    SettingsCard:
                                        SettingsHeader:
                                            icon: icons.REFRESH
                                            title: tr("Updates")
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Check for updates automatically")
                                            SwitchPill:
                                                id: update_switch
                                                text: tr("Yes") if self.active else tr("No")
                                                active: root.auto_update
                                                tooltip_text: tr("Check for updates automatically")
                                                pos_hint: {"center_y": .5}
                                                on_release: root.set_auto_update(self.active)
                                        SettingsRow:
                                            SettingsRowLabel:
                                                text: tr("Version {version}", version=root.current_version)
                                                color: theme.MUTED
                                            CardButton:
                                                text: tr("Check now")
                                                size_hint_x: None
                                                width: dp(130)
                                                tooltip_text: tr("Check for updates now")
                                                pos_hint: {"center_y": .5}
                                                on_release: root.check_updates(True)


    BoxLayout:
        size_hint_y: None
        height: dp(40)
        padding: [dp(16), dp(4)]
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: theme.SURFACE
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: root.status_text
            color: theme.MUTED
            font_size: sp(12)
            size_hint_x: None
            # Mientras se descarga cede sitio a la barra: con un ancho fijo de
            # 470 px la barra se quedaba en un cuadradito en ventanas estrechas.
            width: min(dp(470), max(dp(150), self.parent.width * (0.34 if root.downloading else 0.62)))
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
        AppProgressBar:
            id: progress_bar
            max: 100
            value: root.progress
            height: dp(12)
            size_hint_y: None
            pos_hint: {"center_y": .5}
            # Solo se muestra mientras hay una descarga en curso.
            opacity: 1 if root.downloading else 0
            disabled: not root.downloading
        Label:
            text: "{:.0f} %".format(root.progress)
            color: theme.TEXT
            font_size: sp(12)
            size_hint_x: None
            width: dp(42) if root.downloading else 0
            opacity: 1 if root.downloading else 0
            halign: "right"
            valign: "middle"
            text_size: self.size
        CardButton:
            text: tr("Cancel")
            size_hint_x: None
            width: dp(100)
            height: dp(30)
            opacity: 1 if root.downloading else 0
            disabled: not root.downloading
            on_release: root.cancel_download()
        # Barra de zoom: solo en modo rejilla y fuera de los ajustes.
        # El bloque se oculta colapsando su ancho en los demás casos.
        BoxLayout:
            id: zoom_box
            size_hint_x: None
            width: dp(130) if root.show_zoom else 0
            opacity: 1 if root.show_zoom else 0
            disabled: not root.show_zoom
            ZoomSlider:
                id: zoom_slider
                min: 0.6
                max: 1.8
                value: root.zoom
                disabled: not root.show_zoom
                on_value: root.set_zoom(self.value)
