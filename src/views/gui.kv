#:kivy 1.11.1

# colores:
#:import C kivy.utils.get_color_from_hex
#:set SPINNERFG C("424242")
#:set SPINNERBGOP C("212121")

<SpinnerOption>:
    size_hint: None, None
    size: 100, 24
    background_normal: ""
    background_down: ""
    background_color: SPINNERBGOP
    spacing: [0, 0]
    border: [0, 0, 0, 0]
    font_size: "10sp"
    bold: True
    # texto alineado a la izquierda:
    text_size: [80, 0]
    halign:'left'
    valign:'middle'

<MainScreen>:
    canvas.before:
        Color:
            rgb: (66/255.0, 66/255.0, 66/255.0)
        Rectangle:
            pos: self.pos
            size: self.size



    GridLayout:
        cols: 1
        rows: 2
        spacing: [5, 5]
        padding: [5, 5, 5, 5]

        GridLayout:
            cols: 2
            rows: 1
            size_hint: (1.0, 1.0) # 1.0 es igual a 100%
            size_hint_max_y: 35
            spacing: [5, 5]
            padding: [5, 5, 5, 5]

            Spinner:
                id: "dropdown"
                text: root.set_platform_name()
                values: "Windows", "Mac", "GNU/Linux"
                size_hint: (None, None)
                size: (100, 24)
                on_text: root.print_current(self.text)
                background_normal: "views/assets/dropdown.png"
                background_down: "views/assets/dropdown_down.png"
                border: [0, 0, 0, 0]
                font_size: "10sp"
                bold: True
                # texto alineado a la izquierda:
                text_size: [80, 0]
                halign:'left'
                valign:'middle'

            Spinner:
                id: "arch"
                text: "64"
                values: "64", "32"
                size_hint: (None, None)
                size: (38, 24)
                on_text: root.print_current(self.text)
                background_normal: "views/assets/dropdown_small.png"
                background_down: "views/assets/dropdown_down_small.png"
                border: [0, 0, 0, 0]
                font_size: "10sp"
                bold: True
                # texto alineado a la izquierda:
                text_size: [25, 0]
                halign:'left'
                valign:'middle'


        # Tabs:
        GridLayout:
            cols: 2
            rows: 1
            spacing: [5, 5]
            padding: [5, 5, 5, 5]

            TabbedPanel:
                do_default_tab: False
                border: [0.0, 0.0, 0.0, 0.0]
                pos: [0.0, 0.0]
                tab_height: 28
                #tab_pos: 'left_top'
                #tab_pos: 'left_mid'
                #tab_pos: 'right_top'
                tab_pos: 'top_left'
                #tab_pos: 'top_mid'
                #tab_pos: 'top_right'
                #tab_pos: 'bottom_mid'
                size_hint_max_x: root.width-142

                TabbedPanelItem:
                    text: 'Installed'
                    font_size: "12sp"
                    bold: True
                    size_hint: (None, None)
                    width: 112
                    height: 30
                    top: 30
                    border: [0.0, 0.0, 0.0, 0.0]
                    pos: [100.0, 0]
                    background_normal: "views/assets/tabs.png"
                    background_down: "views/assets/tabs_down.png"
                    Label:
                        text: 'List of installed versions'

                TabbedPanelItem:
                    text: 'Stable'
                    font_size: "12sp"
                    bold: True
                    size_hint: (None, None)
                    width: 112
                    height: 30
                    top: 30
                    border: [0.0, 0.0, 0.0, 0.0]
                    pos: [100.0, 0]
                    background_normal: "views/assets/tabs.png"
                    background_down: "views/assets/tabs_down.png"
                    Label:
                        text: 'List of stable versions avalidable in remote servers'

                TabbedPanelItem:
                    text: 'BuildBot'
                    font_size: "12sp"
                    bold: True
                    size_hint: (None, None)
                    width: 112
                    height: 30
                    top: 30
                    border: [0.0, 0.0, 0.0, 0.0]
                    pos: [100.0, 0]
                    background_normal: "views/assets/tabs.png"
                    background_down: "views/assets/tabs_down.png"
                    Label:
                        text: 'List of buildbots versions avalidable in remote servers'
            GridLayout:
                cols: 1
                rows: 3
                spacing: [5, 5]
                padding: [5, 5, 5, 5]
                size_hint: [0.1, 1.0]

                Button:
                    id: "button_download"
                    text: 'Download'
                    background_normal: "views/assets/button.png"
                    background_down: "views/assets/button_down.png"
                    size_hint: (None, None)
                    width: 112
                    height: 28
                    font_size: "10sp"
                    bold: True

                Button:
                    id: "button_launch"
                    text: 'Launch'
                    background_normal: "views/assets/button.png"
                    background_down: "views/assets/button_down.png"
                    size_hint: (None, None)
                    width: 112
                    height: 28
                    font_size: "10sp"
                    bold: True

                Button:
                    id: "button_settings"
                    text: 'Settings'
                    background_normal: "views/assets/button.png"
                    background_down: "views/assets/button_down.png"
                    size_hint: (None, None)
                    width: 112
                    height: 28
                    font_size: "10sp"
                    bold: True
                    on_press:
                        root.manager.transition.direction = 'down'
                        root.manager.current = 'settings'


<PreferencesScreen>:
    canvas.before:
        Color:
            rgb: (66/255.0, 66/255.0, 66/255.0)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        padding: "5sp"
        spacing: "8sp"
        Button:
            text: 'Come back'
            background_color: (1, 0, 0, .8)
            on_press:
                root.manager.transition.direction = 'up'
                root.manager.current = 'main_screen'
        
        Button:
            text: 'boton2'
            background_color: (0, 1, 0, .8)

